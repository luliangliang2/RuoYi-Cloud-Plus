<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.ssssssss.magicapi.iot</groupId>
    <artifactId>magic-api-iot-plugins</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.3</spring-boot.version>
        <junit.version>5.12.2</junit.version>
        <mica-mqtt.version>2.6.6</mica-mqtt.version>
        <digitalpetri-modbus.version>2.1.6</digitalpetri-modbus.version>
        <nacos-client.version>2.5.1</nacos-client.version>
        <curator.version>5.7.1</curator.version>
        <jetcd.version>0.8.5</jetcd.version>
        <iot.jetcd.grpc.version>1.70.0</iot.jetcd.grpc.version>
    </properties>

    <modules>
        <module>platform/magic-api-plugin-api</module>
        <module>platform/magic-api-plugin-runtime</module>
        <module>platform/magic-api-plugin-spring-boot-starter</module>
        <module>core/magic-api-plugin-iot-core</module>
        <module>core/magic-api-plugin-protocol</module>
        <module>core/magic-api-plugin-command</module>
        <module>core/magic-api-plugin-observability</module>
        <module>core/magic-api-plugin-security</module>
        <module>core/magic-api-plugin-iot-cluster</module>
        <module>core/magic-api-plugin-configuration-center</module>
        <module>features/magic-api-plugin-device-shadow</module>
        <module>features/magic-api-plugin-product-model</module>
        <module>features/magic-api-plugin-rule-engine</module>
        <module>features/magic-api-plugin-ota</module>
        <module>features/magic-api-plugin-timeseries</module>
        <module>features/magic-api-plugin-storage-router</module>
        <module>features/magic-api-plugin-northbound</module>
        <module>features/magic-api-plugin-ops-console</module>
        <module>adapters/magic-api-plugin-protocol-adapters</module>
        <module>adapters/magic-api-plugin-protocol-modbus-tcp</module>
        <module>adapters/magic-api-plugin-handshake-basic</module>
        <module>providers/magic-api-plugin-transport-tcp</module>
        <module>providers/magic-api-plugin-transport-mqtt</module>
        <module>providers/magic-api-plugin-transport-mqtt-client</module>
        <module>providers/magic-api-plugin-node-registry-nacos</module>
        <module>providers/magic-api-plugin-node-registry-zookeeper</module>
        <module>providers/magic-api-plugin-node-registry-etcd</module>
        <module>providers/magic-api-plugin-configuration-center-nacos</module>
        <module>providers/magic-api-plugin-configuration-center-zookeeper</module>
        <module>providers/magic-api-plugin-configuration-center-etcd</module>
        <module>providers/magic-api-plugin-device-registry-memory</module>
        <module>providers/magic-api-plugin-device-session-memory</module>
        <module>providers/magic-api-plugin-message-bus-memory</module>
        <module>providers/magic-api-plugin-redis-support</module>
        <module>providers/magic-api-plugin-device-registry-redis</module>
        <module>providers/magic-api-plugin-device-session-redis</module>
        <module>providers/magic-api-plugin-message-bus-kafka</module>
        <module>providers/magic-api-plugin-message-bus-pulsar</module>
        <module>providers/magic-api-plugin-message-bus-rocketmq</module>
        <module>platform/magic-api-plugin-testkit</module>
        <module>examples/magic-api-plugin-handshake-example</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-api</artifactId>
                <version>${iot.jetcd.grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-core</artifactId>
                <version>${iot.jetcd.grpc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
